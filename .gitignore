__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
.env
*.log
# Local vector store / data caches
chroma/
.chroma/
data_cache/
.aristos_cache/
# Frozen run records — raw vendor payloads captured for offline replay (Company Check
# cohort context). NOT committed: vendor-data redistribution (ITEM 1).
runs/
universes/portfolio_watch_v1.yaml
acceptance_out/
# Auto-persisted universe-run .md/.html (UI-FIX-1) — a disposable, byte-identical
# recovery copy of what the download buttons serve, not the committed report record
# (reports/<TICKER>/*.json stays committed; only this subdirectory is ignored).
reports/universe_runs/
# HOLDINGS-RUN-1 backstop: the owner's private holdings export and its graded output
# belong OUTSIDE this (public) repo, and examples/grade_holdings.py REFUSES an in-repo
# path. These entries are the second line of defence for the conventional filenames —
# a stray copy must not ride along in a 'git add -A'.
holdings*.csv
holdings*.txt

# COHORT-1 — built cohorts are machine-generated local data, rebuilt from the rule.
# definitions.yaml IS source and stays tracked (the negation below). See docs/COHORTS.md.
data/local/cohorts/*/
!data/local/cohorts/definitions.yaml

# COHORT-1 — cohort lists registered for the UI, one per build. The frozen members.csv
# is the record; this is a copy for the sidebar.
universes/local/cohort_*.yaml

# MARKET-INDEX-1 — the local market table is machine-built and rebuildable from
# EODHD; market_index.yaml (the rule) IS tracked. See docs/MARKET_INDEX.md.
data/local/market_index/

# GAP-LEDGER-1 — the pre-market screener's local record: one CSV per trading day plus
# its daily-bar cache. Machine-written local data, rebuildable by re-running the screen,
# and a log of what was looked at on which morning. See docs/GAP_LEDGER.md.
data/local/gap_ledger/
